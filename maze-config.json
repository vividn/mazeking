{
  "$schema": "./maze-config.schema.json",
  "$comment": "Single source of truth for maze constants. Run 'just generate-constants' after changes.",

  "maxMazeCells": 3000,
  "maxMoves": 1000,

  "$derived": {
    "maxPackedBytes": "maxMazeCells / 2",
    "publicInputsLength": "2 (maze_hash + move_count)",
    "layoutHeaderBytes": 20,
    "layoutTotalBytes": "layoutHeaderBytes + maxPackedBytes"
  }
}
